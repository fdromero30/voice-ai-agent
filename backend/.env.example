# ============================================================================
# Voice AI Agent - Variables de Entorno
# ============================================================================

# Groq Cloud API Key (OBLIGATORIA)
# Obtén tu API Key gratis en: https://console.groq.com/keys
GROQ_API_KEY=tu_api_key_aqui

# Puerto del servidor (OPCIONAL)
# En desarrollo local usa 8000. En la nube (Render, Railway, etc.)
# se define automáticamente vía variable PORT.
PORT=8000